# Copia este archivo como `.env` (misma carpeta, junto a app.py) y rellena la clave.
# `.env` NO se sube al repositorio: está en .gitignore.

# Enciende el chat de Pai. Sin esta línea, la app arranca con el chat apagado.
PAIDEIA_GROQ_ENABLED=1

# Clave de Groq. Sustituye el valor; no la escribas en el chat, en capturas ni en el código.
GROQ_API_KEY=

# Opcional. Solo se aceptan openai/gpt-oss-20b u openai/gpt-oss-120b.
PAIDEIA_GROQ_MODEL=openai/gpt-oss-20b

# Opcional. Segundos de espera por respuesta (0,1 a 60). Por defecto 60.
PAIDEIA_GROQ_TIMEOUT=60

# Opcional. Tope de tokens de salida del chat (32 a 2400). Por defecto 2400.
PAIDEIA_GROQ_MAX_TOKENS=2400
