{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paideia:education:selection:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "intent",
    "claim_ids"
  ],
  "properties": {
    "version": {
      "const": "paideia-education-v1"
    },
    "intent": {
      "enum": [
        "explain",
        "calculate"
      ]
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "saving_investing",
          "risk",
          "inflation",
          "guarantees",
          "simulation"
        ]
      }
    }
  },
  "$comment": "Selection only. User scenario is a separate request field; this schema is documentation of the implemented validator, not a replacement for it."
}