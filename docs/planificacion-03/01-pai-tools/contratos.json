{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paideia:contracts:0.1",
  "title": "Paideia Pai ↔ backend ↔ PostgreSQL — contratos",
  "description": "Bundle JSON Schema 2020-12. Propuesta contractual; no implementada. Las extensiones x-* son metadatos del bundle, no configuración de proveedor.",
  "x-contract-version": "0.1-draft",
  "x-status": "proposed-not-implemented",
  "x-http-endpoint": {
    "method": "POST",
    "path": "/v1/chat/turns",
    "request_schema": "#/$defs/ConversationTurnRequest",
    "response_schema": "#/$defs/ConversationTurnResponse",
    "transport": "HTTPS; application/json; Cache-Control: no-store"
  },
  "x-tool-registry": [
    {"name": "search_products", "input_schema": "#/$defs/SearchProductsInput", "output_schema": "#/$defs/SearchProductsOutput", "effect": "catalog_read_only"},
    {"name": "get_product_detail", "input_schema": "#/$defs/GetProductDetailInput", "output_schema": "#/$defs/GetProductDetailOutput", "effect": "catalog_read_only"},
    {"name": "compare_products", "input_schema": "#/$defs/CompareProductsInput", "output_schema": "#/$defs/CompareProductsOutput", "effect": "catalog_read_only"},
    {"name": "calculate_scenario", "input_schema": "#/$defs/CalculateScenarioInput", "output_schema": "#/$defs/CalculateScenarioOutput", "effect": "deterministic_pure_calculation"},
    {"name": "get_sources", "input_schema": "#/$defs/GetSourcesInput", "output_schema": "#/$defs/GetSourcesOutput", "effect": "catalog_read_only"}
  ],
  "$defs": {
    "UUIDv4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUID v4; IDs never identify a person."
    },
    "ProviderCallId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Identificador opaco devuelto por la API de modelo; sólo se conserva durante el ciclo de tool calling."
    },
    "TimestampUTC": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "BusinessDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "DateOrTimestamp": {
      "anyOf": [{"$ref": "#/$defs/BusinessDate"}, {"$ref": "#/$defs/TimestampUTC"}]
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$",
      "description": "Decimal positivo/no negativo como texto para evitar pérdida de precisión."
    },
    "SignedDecimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$"
    },
    "ProductFamily": {
      "type": "string",
      "enum": ["remunerated_account", "term_deposit", "treasury_bill", "government_bond", "mutual_fund", "etf"]
    },
    "FieldKey": {
      "type": "string",
      "enum": ["nominal_rate_percent", "tae_percent", "yield_percent", "term_months", "minimum_amount_eur", "minimum_initial_amount_eur", "nav_per_share_eur", "market_price_eur", "total_expense_ratio_percent", "risk_indicator", "currency", "liquidity", "issuer_country", "maturity_date", "redemption_fee_percent"]
    },
    "ToolName": {
      "type": "string",
      "enum": ["search_products", "get_product_detail", "compare_products", "calculate_scenario", "get_sources"]
    },
    "ProfileContext": {
      "type": "object",
      "properties": {
        "knowledge_level": {"type": "string", "enum": ["beginner", "basic", "intermediate", "advanced", "unknown"]},
        "experience": {"type": "string", "enum": ["none", "limited", "experienced", "unknown"]},
        "risk_tolerance": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "loss_capacity": {"type": "string", "enum": ["cannot_lose", "limited", "moderate", "high", "unknown"]},
        "objective": {"type": "string", "enum": ["emergency_reserve", "debt_reduction", "capital_preservation", "income", "growth", "learn", "unknown"]},
        "horizon_months": {"type": ["integer", "null"], "minimum": 0, "maximum": 1200},
        "liquidity_need": {"type": "string", "enum": ["immediate", "within_3_months", "within_1_year", "longer_term", "unknown"]},
        "monthly_income_eur": {"anyOf": [{"$ref": "#/$defs/DecimalString"}, {"type": "null"}]},
        "monthly_expenses_eur": {"anyOf": [{"$ref": "#/$defs/DecimalString"}, {"type": "null"}]},
        "liquid_assets_eur": {"anyOf": [{"$ref": "#/$defs/DecimalString"}, {"type": "null"}]},
        "total_debt_eur": {"anyOf": [{"$ref": "#/$defs/DecimalString"}, {"type": "null"}]},
        "monthly_debt_commitments_eur": {"anyOf": [{"$ref": "#/$defs/DecimalString"}, {"type": "null"}]},
        "situation_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["student", "variable_income", "self_employed", "dependants", "near_term_obligation", "unknown"]}
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Consent": {
      "type": "object",
      "properties": {
        "notice_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "accepted_chat_processing": {"const": true, "description": "Prerrequisito del turno remoto. Rechazar el aviso se gestiona localmente y no autoriza enviar una petición al LLM."},
        "store_local_profile": {"type": "boolean"},
        "share_profile_with_model": {"type": "boolean"},
        "confirmed_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["notice_version", "accepted_chat_processing", "store_local_profile", "share_profile_with_model", "confirmed_at"],
      "additionalProperties": false
    },
    "HistoryMessage": {
      "type": "object",
      "properties": {
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "ConversationTurnRequest": {
      "type": "object",
      "properties": {
        "contract_version": {"const": "0.1"},
        "request_id": {"$ref": "#/$defs/UUIDv4"},
        "conversation_id": {"$ref": "#/$defs/UUIDv4"},
        "turn_id": {"$ref": "#/$defs/UUIDv4"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "history": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/HistoryMessage"}},
        "consent": {"$ref": "#/$defs/Consent"},
        "profile_context": {"$ref": "#/$defs/ProfileContext"}
      },
      "required": ["contract_version", "request_id", "conversation_id", "turn_id", "message", "history", "consent"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"consent": {"properties": {"share_profile_with_model": {"const": false}}, "required": ["share_profile_with_model"]}}, "required": ["consent"]},
          "then": {"not": {"required": ["profile_context"]}}
        }
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "enum": ["CONSENT_REQUIRED", "PROFILE_CONSENT_MISMATCH", "INVALID_REQUEST", "INVALID_TOOL_CALL", "CONTEXT_LIMIT", "PRODUCT_NOT_FOUND", "SOURCE_NOT_FOUND", "CATALOG_UNAVAILABLE", "MODEL_UNAVAILABLE", "MODEL_REFUSAL", "INVALID_MODEL_RESPONSE", "RATE_LIMITED", "INTERNAL_ERROR"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 300},
        "retryable": {"type": "boolean"}
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "source_id": {"$ref": "#/$defs/UUIDv4"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_type": {"type": "string", "enum": ["official_document", "official_page", "issuer_page", "regulatory_filing", "market_data", "other"]},
        "published_at": {"anyOf": [{"$ref": "#/$defs/DateOrTimestamp"}, {"type": "null"}]},
        "retrieved_at": {"$ref": "#/$defs/TimestampUTC"},
        "field_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/FieldKey"}},
        "verification": {"type": "string", "enum": ["captured_not_reviewed", "human_checked", "machine_ingested", "secondary_source"]},
        "reuse_status": {"type": "string", "enum": ["unknown", "citation_only", "redistribution_reviewed"]}
      },
      "required": ["source_id", "title", "publisher", "canonical_url", "source_type", "published_at", "retrieved_at", "field_keys", "verification", "reuse_status"],
      "additionalProperties": false
    },
    "FieldValue": {
      "type": "object",
      "properties": {
        "field_key": {"$ref": "#/$defs/FieldKey"},
        "value": {"type": ["string", "boolean", "null"], "description": "Los decimales se serializan como string; nunca como float."},
        "unit": {"type": ["string", "null"]},
        "as_of": {"anyOf": [{"$ref": "#/$defs/BusinessDate"}, {"type": "null"}]},
        "observed_at": {"anyOf": [{"$ref": "#/$defs/DateOrTimestamp"}, {"type": "null"}]},
        "quality": {"type": "string", "enum": ["verified_current", "verified_stale", "unknown", "disputed", "hypothetical"]},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/UUIDv4"}}
      },
      "required": ["field_key", "value", "unit", "as_of", "observed_at", "quality", "source_ids"],
      "additionalProperties": false
    },
    "ProductSummary": {
      "type": "object",
      "properties": {
        "product_id": {"$ref": "#/$defs/UUIDv4"},
        "snapshot_id": {"$ref": "#/$defs/UUIDv4"},
        "family": {"$ref": "#/$defs/ProductFamily"},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 160},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "external_id": {"type": ["string", "null"], "maxLength": 64},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "summary": {"type": ["string", "null"], "maxLength": 800},
        "fields": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/FieldValue"}},
        "updated_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["product_id", "snapshot_id", "family", "issuer", "name", "external_id", "currency", "summary", "fields", "updated_at"],
      "additionalProperties": false
    },
    "ToolStatus": {
      "type": "string",
      "enum": ["ok", "partial", "not_found", "rejected", "temporarily_unavailable"]
    },
    "SearchProductsInput": {
      "type": "object",
      "properties": {
        "query": {"type": "string", "maxLength": 180},
        "families": {"type": "array", "uniqueItems": true, "maxItems": 6, "items": {"$ref": "#/$defs/ProductFamily"}},
        "filters": {
          "type": "object",
          "properties": {
            "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
            "issuer_country": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
            "rate_field": {"type": ["string", "null"], "enum": ["nominal_rate_percent", "tae_percent", "yield_percent", null]},
            "minimum_rate_percent": {"anyOf": [{"$ref": "#/$defs/SignedDecimalString"}, {"type": "null"}]},
            "maximum_rate_percent": {"anyOf": [{"$ref": "#/$defs/SignedDecimalString"}, {"type": "null"}]},
            "maximum_term_months": {"type": ["integer", "null"], "minimum": 0, "maximum": 1200}
          },
          "required": ["currency", "issuer_country", "rate_field", "minimum_rate_percent", "maximum_rate_percent", "maximum_term_months"],
          "additionalProperties": false
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 20}
      },
      "required": ["query", "families", "filters", "limit"],
      "additionalProperties": false
    },
    "SearchProductsOutput": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/UUIDv4"},
        "status": {"$ref": "#/$defs/ToolStatus"},
        "items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/ProductSummary"}},
        "citations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Citation"}},
        "snapshot_id": {"anyOf": [{"$ref": "#/$defs/UUIDv4"}, {"type": "null"}]},
        "generated_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["tool_call_id", "status", "items", "citations", "snapshot_id", "generated_at"],
      "additionalProperties": false
    },
    "GetProductDetailInput": {
      "type": "object",
      "properties": {
        "product_id": {"$ref": "#/$defs/UUIDv4"},
        "detail_level": {"type": "string", "enum": ["summary", "full"]},
        "as_of": {"anyOf": [{"$ref": "#/$defs/BusinessDate"}, {"type": "null"}]}
      },
      "required": ["product_id", "detail_level", "as_of"],
      "additionalProperties": false
    },
    "GetProductDetailOutput": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/UUIDv4"},
        "status": {"$ref": "#/$defs/ToolStatus"},
        "product": {"anyOf": [{"$ref": "#/$defs/ProductSummary"}, {"type": "null"}]},
        "citations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Citation"}},
        "generated_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["tool_call_id", "status", "product", "citations", "generated_at"],
      "additionalProperties": false
    },
    "CompareProductsInput": {
      "type": "object",
      "properties": {
        "product_ids": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/UUIDv4"}},
        "field_keys": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/FieldKey"}},
        "as_of": {"anyOf": [{"$ref": "#/$defs/BusinessDate"}, {"type": "null"}]}
      },
      "required": ["product_ids", "field_keys", "as_of"],
      "additionalProperties": false
    },
    "ExcludedField": {
      "type": "object",
      "properties": {
        "field_key": {"$ref": "#/$defs/FieldKey"},
        "reason": {"type": "string", "enum": ["missing", "stale", "disputed", "not_applicable", "incompatible_units"]}
      },
      "required": ["field_key", "reason"],
      "additionalProperties": false
    },
    "CompareProductsOutput": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/UUIDv4"},
        "status": {"$ref": "#/$defs/ToolStatus"},
        "comparison_status": {"type": "string", "enum": ["comparable", "partial", "not_comparable"]},
        "products": {"type": "array", "minItems": 0, "maxItems": 4, "items": {"$ref": "#/$defs/ProductSummary"}},
        "excluded_fields": {"type": "array", "items": {"$ref": "#/$defs/ExcludedField"}},
        "citations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Citation"}},
        "generated_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["tool_call_id", "status", "comparison_status", "products", "excluded_fields", "citations", "generated_at"],
      "additionalProperties": false
    },
    "CalculateScenarioInput": {
      "type": "object",
      "properties": {
        "principal_eur": {"$ref": "#/$defs/DecimalString"},
        "annual_rate_percent": {"$ref": "#/$defs/SignedDecimalString"},
        "duration_months": {"type": "integer", "minimum": 1, "maximum": 1200},
        "method": {"type": "string", "enum": ["simple", "compound"]},
        "compound_periods_per_year": {"type": ["integer", "null"], "enum": [1, 2, 4, 12, null]},
        "currency": {"const": "EUR"}
      },
      "required": ["principal_eur", "annual_rate_percent", "duration_months", "method", "compound_periods_per_year", "currency"],
      "additionalProperties": false
    },
    "CalculateScenarioOutput": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/UUIDv4"},
        "status": {"$ref": "#/$defs/ToolStatus"},
        "hypothetical": {"const": true},
        "principal_eur": {"$ref": "#/$defs/DecimalString"},
        "interest_eur": {"$ref": "#/$defs/SignedDecimalString"},
        "ending_balance_eur": {"$ref": "#/$defs/DecimalString"},
        "formula": {"type": "string", "enum": ["A=P*(1+r*t)", "A=P*(1+r/m)^(m*t)"]},
        "formula_version": {"type": "string", "const": "interest-v1"},
        "rounding": {"type": "string", "const": "EUR 2 decimals; ROUND_HALF_UP"},
        "assumptions": {"type": "array", "items": {"type": "string", "maxLength": 160}},
        "citations": {"type": "array", "maxItems": 0},
        "generated_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["tool_call_id", "status", "hypothetical", "principal_eur", "interest_eur", "ending_balance_eur", "formula", "formula_version", "rounding", "assumptions", "citations", "generated_at"],
      "additionalProperties": false
    },
    "GetSourcesInput": {
      "type": "object",
      "properties": {"source_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/UUIDv4"}}},
      "required": ["source_ids"],
      "additionalProperties": false
    },
    "GetSourcesOutput": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/UUIDv4"},
        "status": {"$ref": "#/$defs/ToolStatus"},
        "sources": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Citation"}},
        "generated_at": {"$ref": "#/$defs/TimestampUTC"}
      },
      "required": ["tool_call_id", "status", "sources", "generated_at"],
      "additionalProperties": false
    },
    "ModelToolCall": {
      "oneOf": [
        {"$ref": "#/$defs/ModelSearchProductsCall"},
        {"$ref": "#/$defs/ModelGetProductDetailCall"},
        {"$ref": "#/$defs/ModelCompareProductsCall"},
        {"$ref": "#/$defs/ModelCalculateScenarioCall"},
        {"$ref": "#/$defs/ModelGetSourcesCall"}
      ]
    },
    "ModelSearchProductsCall": {
      "type": "object",
      "properties": {"provider_call_id": {"$ref": "#/$defs/ProviderCallId"}, "name": {"const": "search_products"}, "arguments": {"$ref": "#/$defs/SearchProductsInput"}},
      "required": ["provider_call_id", "name", "arguments"], "additionalProperties": false
    },
    "ModelGetProductDetailCall": {
      "type": "object",
      "properties": {"provider_call_id": {"$ref": "#/$defs/ProviderCallId"}, "name": {"const": "get_product_detail"}, "arguments": {"$ref": "#/$defs/GetProductDetailInput"}},
      "required": ["provider_call_id", "name", "arguments"], "additionalProperties": false
    },
    "ModelCompareProductsCall": {
      "type": "object",
      "properties": {"provider_call_id": {"$ref": "#/$defs/ProviderCallId"}, "name": {"const": "compare_products"}, "arguments": {"$ref": "#/$defs/CompareProductsInput"}},
      "required": ["provider_call_id", "name", "arguments"], "additionalProperties": false
    },
    "ModelCalculateScenarioCall": {
      "type": "object",
      "properties": {"provider_call_id": {"$ref": "#/$defs/ProviderCallId"}, "name": {"const": "calculate_scenario"}, "arguments": {"$ref": "#/$defs/CalculateScenarioInput"}},
      "required": ["provider_call_id", "name", "arguments"], "additionalProperties": false
    },
    "ModelGetSourcesCall": {
      "type": "object",
      "properties": {"provider_call_id": {"$ref": "#/$defs/ProviderCallId"}, "name": {"const": "get_sources"}, "arguments": {"$ref": "#/$defs/GetSourcesInput"}},
      "required": ["provider_call_id", "name", "arguments"], "additionalProperties": false
    },
    "ToolEvent": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/UUIDv4"},
        "name": {"$ref": "#/$defs/ToolName"},
        "state": {"type": "string", "enum": ["selected", "validated", "executed", "rejected"]},
        "status": {"$ref": "#/$defs/ToolStatus"}
      },
      "required": ["tool_call_id", "name", "state", "status"],
      "additionalProperties": false
    },
    "ConversationTurnResponse": {
      "type": "object",
      "properties": {
        "contract_version": {"const": "0.1"},
        "request_id": {"$ref": "#/$defs/UUIDv4"},
        "conversation_id": {"$ref": "#/$defs/UUIDv4"},
        "turn_id": {"$ref": "#/$defs/UUIDv4"},
        "state": {"type": "string", "enum": ["complete", "clarification_required", "degraded", "refused", "failed"]},
        "message": {"type": ["string", "null"], "maxLength": 4000},
        "tool_events": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/ToolEvent"}},
        "citations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Citation"}},
        "context_truncated": {"type": "boolean"},
        "generated_at": {"$ref": "#/$defs/TimestampUTC"},
        "error": {"anyOf": [{"$ref": "#/$defs/Error"}, {"type": "null"}]}
      },
      "required": ["contract_version", "request_id", "conversation_id", "turn_id", "state", "message", "tool_events", "citations", "context_truncated", "generated_at", "error"],
      "additionalProperties": false
    }

  }
}
