{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paideia:comparador:comparison-result:1.0.0",
  "title": "Resultado explicable del comparador",
  "description": "Un grupo distinto por familia; ningún ranking global inter-familia ni de idoneidad.",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison_id", "generated_at", "request_id", "request_echo", "groups", "educational_alerts", "global_rank_available", "profile_used_for_order"],
  "properties": {
    "comparison_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string"},
    "request_echo": {"type": "object", "description": "Criterios y filtros efectivamente aplicados; no datos del perfil ajenos a la consulta."},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "educational_alerts": {"type": "array", "items": {"$ref": "#/$defs/alert"}},
    "global_rank_available": {"const": false},
    "profile_used_for_order": {"const": false},
    "source_policy_version": {"type": "string"},
    "freshness_policy_version": {"type": "string"}
  },
  "$defs": {
    "reason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message_es", "field_path", "source_ids", "formula_or_rule", "as_of"],
      "properties": {
        "code": {"enum": ["NUMERIC_COMPARISON_ALLOWED", "CROSS_FAMILY_INFO_ONLY", "NUMERIC_BASIS_MISMATCH", "USER_SORT_APPLIED", "TIE_BREAK_PRODUCT_ID", "CONTRACTING_CLOSED", "CONTRACTING_UNKNOWN", "RESIDENCE_NOT_DECLARED", "RESIDENCE_ELIGIBILITY_UNKNOWN", "RESIDENCE_NOT_SUPPORTED", "LIQUIDITY_FILTER_FAILED", "LIQUIDITY_UNKNOWN", "METRIC_MISSING", "METRIC_STALE", "COSTS_PARTIAL", "COSTS_UNKNOWN", "NET_COMPARISON_BLOCKED_COSTS", "SOURCE_STALE", "CONDITIONS_CHANGED", "GUARANTEE_CONDITIONAL", "GUARANTEE_SCOPE_UNKNOWN", "TAX_BASIS_UNKNOWN", "DATA_CONFLICT", "EDU_ALERT_ONLY", "PROFILE_NOT_USED_FOR_RANKING"]},
        "message_es": {"type": "string", "minLength": 1},
        "field_path": {"type": ["string", "null"]},
        "value_used": {},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "formula_or_rule": {"type": ["string", "null"]},
        "as_of": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["product_id", "disposition", "rank", "reasons", "conditions_version", "cost_coverage", "eligibility_state", "freshness_state"],
      "properties": {
        "product_id": {"type": "string"},
        "disposition": {"enum": ["included", "excluded", "informational_only"]},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "sort_values": {"type": "array", "items": {"type": ["number", "string", "null"]}},
        "metric_value": {"type": ["number", "null"]},
        "metric_code": {"type": ["string", "null"]},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
        "conditions_version": {"type": "string"},
        "cost_coverage": {"enum": ["complete", "partial", "unknown"]},
        "eligibility_state": {"enum": ["supported", "not_supported", "unknown", "not_checked"]},
        "freshness_state": {"enum": ["current", "stale", "mixed", "unknown"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "comparison_class", "rank_available", "metric_basis", "items", "reasons"],
      "properties": {
        "family": {"enum": ["remunerated_account", "term_deposit", "treasury_bill", "government_bond", "mutual_fund", "etf"]},
        "comparison_class": {"enum": ["numeric_within_family", "informational_cross_family", "not_comparable"]},
        "rank_available": {"type": "boolean"},
        "metric_basis": {"type": ["string", "null"], "description": "Definición exacta de la única métrica de orden de este grupo."},
        "amount": {"type": ["number", "null"]},
        "currency": {"type": ["string", "null"]},
        "horizon_days": {"type": ["integer", "null"], "minimum": 0},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
      },
      "allOf": [
        {"if": {"properties": {"comparison_class": {"const": "numeric_within_family"}}, "required": ["comparison_class"]}, "then": {"properties": {"rank_available": {"const": true}}}},
        {"if": {"properties": {"comparison_class": {"enum": ["informational_cross_family", "not_comparable"]}}, "required": ["comparison_class"]}, "then": {"properties": {"rank_available": {"const": false}}}}
      ]
    },
    "alert": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message_es", "trigger", "educational_only", "source_ids"],
      "properties": {
        "code": {"type": "string", "pattern": "^EDU_[A-Z0-9_]+$"},
        "message_es": {"type": "string"},
        "trigger": {"type": "string"},
        "educational_only": {"const": true},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "as_of": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$comment": "Invariantes de dominio adicionales: rank es null fuera de grupo numérico; rank solo se calcula con datos esenciales vigentes y base homogénea; ningún neto con costes incompletos; las razones incluyen dato/fuente/regla; la UI etiqueta orden alfabético si sort_by está vacío."
}
