{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paideia:comparador:comparison-request:1.0.0",
  "title": "Consulta de comparación declarada por el usuario",
  "description": "Solo criterios y filtros expresamente elegidos; no usar perfil financiero para ordenar o recomendar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "created_at", "families", "cohort_mode", "as_of", "sort_by", "filters", "cost_basis", "unknown_policy"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["remunerated_account", "term_deposit", "treasury_bill", "government_bond", "mutual_fund", "etf"]}},
    "product_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "description": "Vacío/no indicado significa todos los del catálogo tras filtros explícitos."},
    "cohort_mode": {"enum": ["within_family", "cross_family_descriptive"]},
    "as_of": {"type": "string", "format": "date-time"},
    "amount": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "horizon_days": {"type": ["integer", "null"], "minimum": 0},
    "metric_code": {"enum": ["reported_tin", "reported_tae", "gross_euros_at_horizon", "bill_annualized_yield_to_maturity", "bond_coupon", "bond_yield_to_maturity", "fund_nav_return", "etf_market_price_return", "etf_nav_return", "priips_scenario", "none"]},
    "sort_by": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": {"enum": ["metric_value", "gross_euros_at_horizon", "total_cost", "term_days", "notice_days", "settlement_days", "display_name", "product_id"]},
        "direction": {"enum": ["asc", "desc"]}
      }
    }, "description": "Prioridad del usuario, de mayor a menor. Sin criterios se usa nombre normalizado + ID, rotulado alfabético."},
    "filters": {
      "type": "object", "additionalProperties": false,
      "required": ["open_for_contracting", "residence", "liquidity"],
      "properties": {
        "open_for_contracting": {"type": ["boolean", "null"], "description": "true exige estado open documentado; false filtra a closed documentado; null no filtra."},
        "channels": {"type": "array", "uniqueItems": true, "items": {"enum": ["online", "branch", "intermediary", "auction", "market", "other"]}},
        "residence": {
          "type": "object", "additionalProperties": false,
          "required": ["declared_jurisdiction", "unknown_eligibility"],
          "properties": {
            "declared_jurisdiction": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
            "unknown_eligibility": {"enum": ["exclude", "include_labeled", "only_unknown"]}
          }
        },
        "liquidity": {
          "type": "object", "additionalProperties": false,
          "required": ["access_needed_by", "unknown_liquidity"],
          "properties": {
            "access_needed_by": {"type": ["string", "null"], "format": "date"},
            "max_settlement_days": {"type": ["integer", "null"], "minimum": 0},
            "unknown_liquidity": {"enum": ["exclude", "include_labeled", "only_unknown"]}
          }
        },
        "require_current_data": {"type": "boolean", "default": true}
      }
    },
    "cost_basis": {"enum": ["gross", "net_total", "cost_only", "descriptive_only"]},
    "tax_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "jurisdiction", "tax_year"],
      "properties": {
        "mode": {"enum": ["gross", "net_illustrative", "not_requested"]},
        "jurisdiction": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
        "tax_year": {"type": ["integer", "null"], "minimum": 2000}
      }
    },
    "unknown_policy": {"enum": ["exclude_from_hard_filter", "include_labeled", "only_unknown"]},
    "user_selected_criteria": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {"enum": ["family", "term_days", "access_needed_by", "max_settlement_days", "contracting_channel", "residence_jurisdiction", "metric_code", "cost_basis"]},
        "operator": {"enum": ["equals", "less_than_or_equal", "greater_than_or_equal", "in", "not_in"]},
        "value": {},
        "display_label": {"type": "string"}
      }
    }, "description": "Eco de preferencias que el usuario eligió, no inferidas."}
  }
}
