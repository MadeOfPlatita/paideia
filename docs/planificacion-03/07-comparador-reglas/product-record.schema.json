{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paideia:comparador:product-record:1.0.0",
  "title": "Ficha de producto trazable",
  "description": "Propuesta de esquema. Estado desconocido nunca equivale a cero, no aplicable o elegible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "family", "display_name", "currency", "contracting", "eligibility", "liquidity", "costs", "guarantees", "metrics", "conditions_version", "observed_at", "sources", "facts"],
  "properties": {
    "product_id": {"type": "string", "minLength": 1, "description": "ID interno inmutable usado para desempate."},
    "family": {"enum": ["remunerated_account", "term_deposit", "treasury_bill", "government_bond", "mutual_fund", "etf"]},
    "display_name": {"type": "string", "minLength": 1},
    "provider_name": {"type": ["string", "null"]},
    "isin": {"type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
    "share_class_or_offer_id": {"type": ["string", "null"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "contracting": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "channels", "evidence_fact_ids"],
      "properties": {
        "status": {"enum": ["open", "closed", "unknown"]},
        "channels": {"type": "array", "items": {"enum": ["online", "branch", "intermediary", "auction", "market", "other", "unknown"]}, "uniqueItems": true},
        "open_until": {"type": ["string", "null"], "format": "date-time"},
        "conditions_summary": {"type": ["string", "null"]},
        "evidence_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "eligibility": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["jurisdiction", "status", "evidence_fact_ids"],
        "properties": {
          "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "status": {"enum": ["supported", "not_supported", "unknown"]},
          "conditions_summary": {"type": ["string", "null"]},
          "evidence_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "liquidity": {
      "type": "object", "additionalProperties": false,
      "required": ["access_type", "notice_days", "settlement_days", "exit_penalty_state", "evidence_fact_ids"],
      "properties": {
        "access_type": {"enum": ["on_demand", "at_maturity", "periodic_redemption", "market_sale", "unknown"]},
        "notice_days": {"type": ["integer", "null"], "minimum": 0},
        "settlement_days": {"type": ["integer", "null"], "minimum": 0},
        "exit_penalty_state": {"enum": ["documented", "none_documented", "unknown"]},
        "exit_penalty_description": {"type": ["string", "null"]},
        "market_price_risk": {"type": "boolean"},
        "evidence_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "costs": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage", "components"],
      "properties": {
        "coverage": {"enum": ["complete", "partial", "unknown"]},
        "components": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["component", "state", "charged_by", "evidence_fact_ids"],
          "properties": {
            "component": {"enum": ["management", "depositary", "account", "custody", "subscription", "redemption", "brokerage", "spread", "fx", "linked_product", "balance_tier", "early_exit", "other"]},
            "state": {"enum": ["known", "not_applicable", "unknown", "stale"]},
            "amount": {"type": ["number", "null"]},
            "unit": {"type": ["string", "null"], "description": "p.ej. EUR, percent_per_year, percent_once; no inferir unidad."},
            "charged_by": {"type": "string", "description": "producto, entidad, distribuidor o mercado"},
            "embedded_or_separate": {"enum": ["embedded", "separate", "conditional", "unknown"]},
            "condition": {"type": ["string", "null"]},
            "evidence_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }}
      }
    },
    "guarantees": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "state", "scope", "conditions", "evidence_fact_ids"],
      "properties": {
        "kind": {"enum": ["contractual_cashflow", "deposit_protection", "capital_protection", "none_documented", "unknown"]},
        "state": {"enum": ["documented", "conditional", "none_documented", "unknown"]},
        "scope": {"type": "string", "description": "titular, entidad, emisor, instrumento, límite y/o vencimiento aplicable"},
        "cap_amount": {"type": ["number", "null"], "minimum": 0},
        "cap_currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "evidence_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }},
    "metrics": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_code", "value", "unit", "basis", "gross_net", "state", "as_of", "evidence_fact_ids"],
      "properties": {
        "metric_code": {"enum": ["reported_tin", "reported_tae", "gross_euros_at_horizon", "bill_annualized_yield_to_maturity", "bond_coupon", "bond_yield_to_maturity", "fund_nav_return", "etf_market_price_return", "etf_nav_return", "priips_scenario", "other"]},
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string"},
        "basis": {"type": "string", "description": "definición explícita de flujos, valoración y anualización"},
        "gross_net": {"enum": ["gross", "net_illustrative", "not_applicable", "unknown"]},
        "state": {"enum": ["documented", "unknown", "stale", "conflicting"]},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "horizon_days": {"type": ["integer", "null"], "minimum": 0},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "evidence_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }},
    "conditions_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "sources": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "url", "document_title", "checked_at"],
      "properties": {
        "source_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "document_title": {"type": "string"},
        "checked_at": {"type": "string", "format": "date-time"},
        "effective_from": {"type": ["string", "null"], "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "locator": {"type": ["string", "null"], "description": "página, cláusula, tabla o sección"}
      }
    }},
    "facts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "field_path", "state", "observed_at", "source_id"],
      "properties": {
        "fact_id": {"type": "string"},
        "field_path": {"type": "string"},
        "state": {"enum": ["documented", "unknown", "stale", "conflicting", "not_applicable"]},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "effective_from": {"type": ["string", "null"], "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "source_id": {"type": ["string", "null"]},
        "evidence_locator": {"type": ["string", "null"]}
      }
    }}
  },
  "$comment": "Regla de dominio adicional: cada hecho material documentado debe apuntar a fuente/localizador; las coberturas complete/known no se aceptan sin evidencia vigente."
}
