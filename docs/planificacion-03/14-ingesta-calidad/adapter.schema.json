{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paideia.example/schemas/adapter.schema.json",
  "title": "Paideia normalized adapter candidate",
  "description": "Contract proposal for a single normalized product/observation candidate. Fixture identifiers are test-only and must never be published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "classification",
    "family",
    "source",
    "identity",
    "facts",
    "idempotency_key"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "classification": { "enum": ["production_candidate", "synthetic_fixture"] },
    "family": {
      "enum": [
        "deposit_offer",
        "public_debt_observation",
        "fund_share_class",
        "market_listing",
        "legal_institution"
      ]
    },
    "source": { "$ref": "#/$defs/source" },
    "identity": { "type": "object" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable logical identity; must not include queried_at/run_id. The publisher computes canonical content_hash separately."
    },
    "review_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "family": { "const": "deposit_offer" } }, "required": ["family"] },
      "then": { "properties": { "identity": { "$ref": "#/$defs/depositIdentity" } } }
    },
    {
      "if": { "properties": { "family": { "const": "public_debt_observation" } }, "required": ["family"] },
      "then": { "properties": { "identity": { "$ref": "#/$defs/publicDebtIdentity" } } }
    },
    {
      "if": { "properties": { "family": { "const": "fund_share_class" } }, "required": ["family"] },
      "then": { "properties": { "identity": { "$ref": "#/$defs/fundShareClassIdentity" } } }
    },
    {
      "if": { "properties": { "family": { "const": "market_listing" } }, "required": ["family"] },
      "then": { "properties": { "identity": { "$ref": "#/$defs/marketListingIdentity" } } }
    },
    {
      "if": { "properties": { "family": { "const": "legal_institution" } }, "required": ["family"] },
      "then": { "properties": { "identity": { "$ref": "#/$defs/legalInstitutionIdentity" } } }
    },
    {
      "if": { "properties": { "classification": { "const": "production_candidate" } }, "required": ["classification"] },
      "then": {
        "properties": {
          "identity": {
            "not": {
              "anyOf": [
                { "properties": { "class_isin": { "pattern": "^TEST-ISIN-" } }, "required": ["class_isin"] },
                { "properties": { "related_class_isin": { "pattern": "^TEST-ISIN-" } }, "required": ["related_class_isin"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code; runtime validator checks against the maintained code list."
    },
    "nullableDate": { "type": ["string", "null"], "format": "date" },
    "nullableDateTime": { "type": ["string", "null"], "format": "date-time" },
    "entityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "enum": ["LEI", "NATIONAL_REGISTER", "LOCAL", "TEST_FIXTURE_ID"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "scopedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "enum": ["ISIN", "TREASURY_EVENT", "BDE_SERIES", "ECB_SDMX", "LOCAL", "TEST_FIXTURE_ID"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_uri",
        "source_record_id",
        "adapter_id",
        "adapter_version",
        "retrieved_at",
        "declared_frequency",
        "license_status",
        "raw_evidence",
        "extraction"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
        "source_uri": { "type": "string", "pattern": "^(https?://|fixture://).+" },
        "source_record_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "document_title": { "type": ["string", "null"], "maxLength": 512 },
        "adapter_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
        "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "source_published_at": { "$ref": "#/$defs/nullableDateTime" },
        "declared_frequency": {
          "enum": ["daily", "weekly", "monthly", "annual", "event_driven", "irregular", "unknown", "by_source_metadata"]
        },
        "license_status": { "enum": ["allowed", "review_required", "blocked", "unknown"] },
        "etag": { "type": ["string", "null"], "maxLength": 512 },
        "last_modified": { "$ref": "#/$defs/nullableDateTime" },
        "raw_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "sha256", "mime_type", "captured_at"],
          "properties": {
            "uri": { "type": "string", "pattern": "^(https?://|fixture://|urn:).+" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "mime_type": { "type": "string", "minLength": 3, "maxLength": 128 },
            "captured_at": { "type": "string", "format": "date-time" }
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "human_verified"],
          "properties": {
            "method": { "enum": ["api_json", "csv", "html", "manual", "pdf_text", "pdf_ocr", "llm_assisted"] },
            "human_verified": { "type": "boolean" },
            "reviewer_ref": { "type": ["string", "null"], "maxLength": 128 }
          }
        }
      }
    },
    "depositIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_key", "legal_entity_ref"],
      "properties": {
        "product_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "legal_entity_ref": { "$ref": "#/$defs/entityReference" },
        "brand_label": { "type": ["string", "null"], "maxLength": 256 },
        "offer_variant": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "publicDebtIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "reference"],
      "properties": {
        "scope": { "enum": ["auction_event", "statistical_series", "individual_security_quote", "reference_series"] },
        "reference": { "$ref": "#/$defs/scopedReference" },
        "security_isin": {
          "type": ["string", "null"],
          "pattern": "^(?:[A-Z]{2}[A-Z0-9]{9}[0-9]|TEST-ISIN-[0-9]{4})$"
        }
      }
    },
    "fundShareClassIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fund_key", "class_isin", "share_class_name"],
      "properties": {
        "fund_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "class_isin": {
          "type": "string",
          "pattern": "^(?:[A-Z]{2}[A-Z0-9]{9}[0-9]|TEST-ISIN-[0-9]{4})$"
        },
        "share_class_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "manager_ref": { "$ref": "#/$defs/entityReference" }
      }
    },
    "marketListingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listing_key", "ticker", "venue_mic", "trading_currency", "related_class_isin"],
      "properties": {
        "listing_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ticker": { "type": "string", "minLength": 1, "maxLength": 64 },
        "venue_mic": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
        "trading_currency": { "$ref": "#/$defs/currency" },
        "related_class_isin": {
          "type": ["string", "null"],
          "pattern": "^(?:[A-Z]{2}[A-Z0-9]{9}[0-9]|TEST-ISIN-[0-9]{4})$"
        }
      }
    },
    "legalInstitutionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_entity_ref"],
      "properties": {
        "legal_entity_ref": { "$ref": "#/$defs/entityReference" },
        "legal_name": { "type": ["string", "null"], "maxLength": 256 },
        "brand_labels": { "type": "array", "items": { "type": "string", "maxLength": 256 } },
        "jurisdiction": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "value", "unit", "source_ref", "validity", "observation"],
      "properties": {
        "field_path": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{1,255}$" },
        "value": { "type": ["string", "boolean"] },
        "unit": {
          "enum": ["MONEY", "PERCENT", "PERCENTAGE_POINT", "BASIS_POINT", "DECIMAL_RATIO", "PRICE_PER_100_NOMINAL", "SHARE", "DAY", "TEXT", "BOOLEAN", "DATE", "DATETIME", "URL"]
        },
        "currency": { "$ref": "#/$defs/currency" },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid_from", "valid_to", "source_explicit"],
          "properties": {
            "valid_from": { "$ref": "#/$defs/nullableDate" },
            "valid_to": { "$ref": "#/$defs/nullableDate" },
            "source_explicit": { "type": "boolean" }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_at", "kind", "precision"],
          "properties": {
            "observed_at": { "type": ["string", "null"] },
            "kind": { "enum": ["contract_terms", "document_version", "auction_event", "statistical_observation", "nav", "market_quote", "entity_status", "other"] },
            "precision": { "enum": ["date", "datetime", "not_stated"] }
          },
          "allOf": [
            {
              "if": { "properties": { "precision": { "const": "date" } }, "required": ["precision"] },
              "then": { "properties": { "observed_at": { "type": "string", "format": "date" } } }
            },
            {
              "if": { "properties": { "precision": { "const": "datetime" } }, "required": ["precision"] },
              "then": { "properties": { "observed_at": { "type": "string", "format": "date-time" } } }
            },
            {
              "if": { "properties": { "precision": { "const": "not_stated" } }, "required": ["precision"] },
              "then": { "properties": { "observed_at": { "type": "null" } } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "unit": { "enum": ["MONEY", "PERCENT", "PERCENTAGE_POINT", "BASIS_POINT", "DECIMAL_RATIO", "PRICE_PER_100_NOMINAL", "SHARE", "DAY"] } }, "required": ["unit"] },
          "then": { "properties": { "value": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" } } }
        },
        {
          "if": { "properties": { "unit": { "enum": ["MONEY", "PRICE_PER_100_NOMINAL"] } }, "required": ["unit"] },
          "then": { "required": ["currency"] }
        },
        {
          "if": { "properties": { "unit": { "const": "BOOLEAN" } }, "required": ["unit"] },
          "then": { "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "unit": { "const": "DATE" } }, "required": ["unit"] },
          "then": { "properties": { "value": { "type": "string", "format": "date" } } }
        },
        {
          "if": { "properties": { "unit": { "const": "DATETIME" } }, "required": ["unit"] },
          "then": { "properties": { "value": { "type": "string", "format": "date-time" } } }
        },
        {
          "if": { "properties": { "validity": { "properties": { "source_explicit": { "const": false } }, "required": ["source_explicit"] } }, "required": ["validity"] },
          "then": {
            "properties": {
              "validity": {
                "properties": { "valid_from": { "type": "null" }, "valid_to": { "type": "null" } }
              }
            }
          }
        }
      ]
    }
  }
}
