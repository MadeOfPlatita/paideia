{
  "$description": "Tokens de una dirección visual propuesta para Paideia; revisión y aprobación de marca pendientes.",
  "color": {
    "$type": "color",
    "palette": {
      "paper": { "$value": "#F7F5EF" },
      "white": { "$value": "#FFFFFF" },
      "ink": { "$value": "#18272D" },
      "secondary": { "$value": "#4F5E62" },
      "blue": { "$value": "#3157B7" },
      "blueHover": { "$value": "#28489B" },
      "bluePressed": { "$value": "#203A83" },
      "terracotta": { "$value": "#B74734" },
      "terracottaHover": { "$value": "#9D3D2E" },
      "terracottaPressed": { "$value": "#823225" },
      "sage": { "$value": "#DDE9E2" },
      "border": { "$value": "#737D7D" },
      "success": { "$value": "#22614F" },
      "successBg": { "$value": "#E3EEE8" },
      "warning": { "$value": "#7F4400" },
      "warningBg": { "$value": "#F7E9D6" },
      "danger": { "$value": "#A1362F" },
      "dangerBg": { "$value": "#F6E4E2" },
      "infoBg": { "$value": "#E6EDF9" },
      "disabledBg": { "$value": "#E8E8E2" }
    },
    "semantic": {
      "canvas": { "$value": "{color.palette.paper}" },
      "surface": { "$value": "{color.palette.white}" },
      "surfaceQuiet": { "$value": "{color.palette.sage}" },
      "textPrimary": { "$value": "{color.palette.ink}" },
      "textSecondary": { "$value": "{color.palette.secondary}" },
      "actionPrimary": { "$value": "{color.palette.blue}" },
      "actionPrimaryHover": { "$value": "{color.palette.blueHover}" },
      "actionPrimaryPressed": { "$value": "{color.palette.bluePressed}" },
      "actionSecondary": { "$value": "{color.palette.terracotta}" },
      "actionSecondaryHover": { "$value": "{color.palette.terracottaHover}" },
      "actionSecondaryPressed": { "$value": "{color.palette.terracottaPressed}" },
      "focus": { "$value": "{color.palette.blue}" },
      "controlBorder": { "$value": "{color.palette.border}" },
      "successText": { "$value": "{color.palette.success}" },
      "successSurface": { "$value": "{color.palette.successBg}" },
      "warningText": { "$value": "{color.palette.warning}" },
      "warningSurface": { "$value": "{color.palette.warningBg}" },
      "errorText": { "$value": "{color.palette.danger}" },
      "errorSurface": { "$value": "{color.palette.dangerBg}" },
      "infoSurface": { "$value": "{color.palette.infoBg}" },
      "disabledSurface": { "$value": "{color.palette.disabledBg}" }
    }
  },
  "typography": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "label": { "$value": "0.75rem" },
      "small": { "$value": "0.875rem" },
      "body": { "$value": "1rem" },
      "h3": { "$value": "1.25rem" },
      "h2": { "$value": "1.5rem" },
      "h1": { "$value": "2rem" },
      "display": { "$value": "2.5rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "label": { "$value": 1.333 },
      "body": { "$value": 1.5 },
      "heading": { "$value": 1.25 },
      "display": { "$value": 1.2 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.02em" },
      "body": { "$value": "0em" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "pill": { "$value": "999px" }
  },
  "layout": {
    "width": {
      "$type": "dimension",
      "desktopNav": { "$value": "232px" },
      "desktopContentMax": { "$value": "1168px" },
      "desktopMainColumnMax": { "$value": "840px" },
      "contextPanel": { "$value": "280px" },
      "mobileGutter": { "$value": "16px" },
      "tabletGutter": { "$value": "24px" }
    },
    "breakpoint": {
      "$type": "dimension",
      "mobileMax": { "$value": "767px" },
      "desktopMin": { "$value": "1200px" }
    }
  },
  "component": {
    "controlHeight": {
      "$type": "dimension",
      "desktop": { "$value": "48px" },
      "mobileMin": { "$value": "44px" },
      "focusOutline": { "$value": "3px" },
      "focusOffset": { "$value": "2px" },
      "border": { "$value": "1px" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "short": { "$value": "120ms" },
      "standard": { "$value": "180ms" },
      "reduced": { "$value": "0ms" }
    }
  }
}
