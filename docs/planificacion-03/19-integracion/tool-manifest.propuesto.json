{
  "version": "0.1-integration-proposal",
  "implemented": false,
  "enabled_by_default": false,
  "prerequisites": [
    "provider_approved_and_free_quota_verified",
    "privacy_review_and_selected_context",
    "dispatch_validation_tests",
    "catalogue_publication_permissions",
    "budget_guard_and_off_switch"
  ],
  "maximum_tool_cycles_per_turn": 1,
  "runtime_search_limit": 5,
  "maximum_compared_products": 4,
  "forbidden_effects": [
    "arbitrary_sql",
    "arbitrary_url",
    "shell",
    "filesystem",
    "writes",
    "payments",
    "real_transactions"
  ],
  "tools": [
    {
      "name": "search_products",
      "input_schema": "../01-pai-tools/contratos.json#/$defs/SearchProductsInput",
      "output_schema": "../01-pai-tools/contratos.json#/$defs/SearchProductsOutput",
      "effect": "catalog_read_only"
    },
    {
      "name": "get_product_detail",
      "input_schema": "../01-pai-tools/contratos.json#/$defs/GetProductDetailInput",
      "output_schema": "../01-pai-tools/contratos.json#/$defs/GetProductDetailOutput",
      "effect": "catalog_read_only"
    },
    {
      "name": "compare_products",
      "input_schema": "../01-pai-tools/contratos.json#/$defs/CompareProductsInput",
      "output_schema": "../01-pai-tools/contratos.json#/$defs/CompareProductsOutput",
      "effect": "catalog_read_only"
    },
    {
      "name": "calculate_scenario",
      "input_schema": "../01-pai-tools/contratos.json#/$defs/CalculateScenarioInput",
      "output_schema": "../01-pai-tools/contratos.json#/$defs/CalculateScenarioOutput",
      "effect": "deterministic_pure_calculation"
    },
    {
      "name": "get_sources",
      "input_schema": "../01-pai-tools/contratos.json#/$defs/GetSourcesInput",
      "output_schema": "../01-pai-tools/contratos.json#/$defs/GetSourcesOutput",
      "effect": "catalog_read_only"
    }
  ]
}