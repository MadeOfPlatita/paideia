+def _clause_before(text, index, limit=90):
+    """Fragmento de la misma oración que precede a `index`, acotado."""
+    start = 0
+    for boundary in _ATTRIBUTION_CLAUSE.finditer(text, 0, index):
+        start = boundary.end()
+    return text[max(start, index - limit):index]
+
+
+def _has_asserted_attribution(text):
+    """True si alguna atribución del texto se afirma (no solo se niega)."""
+    for match in _ATTRIBUTION_SURFACE.finditer(text):
+        matched = match.group(0)
+        if _ATTRIBUTION_NEVER_NEGATED.match(matched.lstrip()) is not None:
+            return True
+        if _FORWARD_NEGATION.match(text[match.end():match.end() + 24]) is not None:
+            continue
+        window = _clause_before(text, match.start())
+        cue = None
+        for found in _NEGATION_CUE.finditer(window):
+            cue = found
+        if cue is None:
+            return True
+        exception_end = None
+        for found in _NEGATION_EXCEPTION.finditer(window):
+            exception_end = found.end()
+        # «Sin duda» afirma; «sin duda no está vigente» niega: manda la última
+        # partícula, no la primera que aparezca en la ventana.
+        if exception_end is not None and cue.start() < exception_end:
+            return True
+    return False
+
+
 def _has_unbacked_claim(text):
     """Compatibilidad: indica si la frontera de superficie retendría el texto."""
     return not _text_surface_gate(text)[0]
