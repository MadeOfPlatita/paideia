 _IDENTIFIER_SURFACE = re.compile(r"\b[A-Z][A-Z0-9]{1,14}(?:-[A-Z0-9]{1,14}){1,2}\b")
 
+# Una atribución negada no afirma nada: es la forma correcta de responder «una
+# fuente secundaria no es oficial». La ventana se corta en la frontera de la
+# oración o del contraste para que «no es oficial, pero el folleto lo publica»
+# siga retenido por la parte que sí afirma.
+_ATTRIBUTION_CLAUSE = re.compile(
+    r"[.,!?;:\n]|\b(?:pero|aunque|sino|mientras|salvo)\b", re.IGNORECASE)
+_NEGATION_CUE = re.compile(r"\b(?:no|nunca|jam[áa]s|tampoco|sin|ni)\b", re.IGNORECASE)
+# Giros que llevan una partícula negativa pero afirman: «sin duda es oficial»,
+# «no cabe duda de que está vigente», «no deja de ser oficial». Los conectores
+# adversativos («no obstante», «sin embargo») también continúan afirmando.
+_NEGATION_EXCEPTION = re.compile(
+    r"\bno\s+(?:es\s+)?(?:solo|solamente|s[óo]lo|[úu]nicamente)\b"
+    r"|\bsin\s+(?:lugar\s+a\s+)?dudas?\b"
+    r"|\bno\s+(?:cabe|hay|queda)\s+(?:ninguna\s+)?duda\b"
+    r"|\bno\s+deja\s+de\b"
+    r"|\bnada\s+menos\s+que\b"
+    r"|\bno\s+obstante\b"
+    r"|\bsin\s+embargo\b"
+    r"|\bno\s+dud(?:o|amos|an)\b"
+    r"|\bno\s+es\s+menos\s+cierto\b"
+    r"|\bno\s+hay\s+quien\s+dude\b",
+    re.IGNORECASE)
+# Una atribución introducida por preposición no se niega con un «no» anterior:
+# «no es un banco según la entidad» sigue citando a la entidad.
+_ATTRIBUTION_NEVER_NEGATED = re.compile(
+    r"^(?:https?://|www\.|fuente\s*:|seg[úu]n\b|de\s+acuerdo\s+con\b|"
+    r"tal\s+como\b|conforme\s+a\b|como\s+confirma\b)",
+    re.IGNORECASE)
+# Un documento puede ser el sujeto de una negación: «el folleto no lo recoge».
+_FORWARD_NEGATION = re.compile(r"^\s*(?:no|nunca|jam[áa]s|tampoco)\b", re.IGNORECASE)
+
 _UNBACKED_CLAIM_NOTES = {
